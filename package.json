{
  "name": "@spectree/invoker",
  "version": "1.60.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "presence"
  ],
  "description": "The Spectree Invoker squad: one protocol, two harness adapters, and the checks that refuse an invalid state.",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "presence": "node scripts/presence.mjs",
    "console": "node scripts/console.mjs",
    "build": "node scripts/build.mjs",
    "check:drift": "node scripts/build.mjs --check",
    "check:plugin": "node scripts/check-plugin.mjs",
    "capabilities": "node scripts/capabilities.mjs",
    "test": "node --test --test-concurrency=8 tests/*.test.mjs",
    "check": "npm run check:drift && npm run check:plugin && npm test"
  }
}
